# בסיס נתונים - פיתוח מקומי (docker compose up -d db)
DATABASE_URL="postgresql://build_app:build_app_dev_password@127.0.0.1:5433/build_app_dev?schema=public"

# בסיס נתונים לבדיקות אוטומטיות
TEST_DATABASE_URL="postgresql://build_app:build_app_dev_password@127.0.0.1:5433/build_app_test?schema=public"

# מפתח חתימת session - חובה להחליף בייצור (openssl rand -hex 32)
SESSION_SECRET="dev-only-change-me-00000000000000000000000000000000"

# מתג עצירה גלובלי - כשהוא true, כל פעולה חיצונית/בלתי-הפיכה חסומה
APP_PAUSED="false"

NODE_ENV="development"
