    "db:studio": "prisma studio",
    "structure:gate": "bash scripts/structure-gate.sh",
    "gates": "bash scripts/gates.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
